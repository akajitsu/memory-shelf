# Copy this file to .env.local and fill in the values from your Supabase project.
# Supabase Dashboard -> Project Settings -> API (or "Connect" button).

# Public project URL, e.g. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url

# Public "anon" / "publishable" key. Safe in the browser because RLS protects all data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key

# The site's public origin, used to build auth redirect links (email confirmation,
# password reset, OAuth). No trailing slash.
#   Local:      http://localhost:3000
#   Production: https://your-app.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# NOTE: This app never needs the Supabase service_role key. Do not add it here,
# and never prefix any secret with NEXT_PUBLIC_.
